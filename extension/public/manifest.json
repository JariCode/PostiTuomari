{
  "manifest_version": 3,
  "name": "PostiTuomari",
  "version": "0.6.0",
  "description": "Lajittelee postin lähettäjän ja otsikon perusteella",
  "browser_specific_settings": {
    "gecko": {
      "id": "postituomari@jaricode.fi",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["rules.js", "rules.local.js", "background.js"]
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "PostiTuomari",
    "default_label": "PostiTuomari",
    "default_popup": "popup/index.html"
  },
  "permissions": [
    "accountsRead",
    "accountsFolders",
    "messagesRead",
    "messagesMove",
    "storage"
  ],
  "host_permissions": ["http://localhost:3001/*"]
}
