{
  "manifest_version": 3,
  "name": "PostiTuomari",
  "version": "1.0.0",
  "description": "Lajittelee postin lähettäjän ja otsikon perusteella",
  "icons": {
    "32": "icons/postituomari.svg",
    "64": "icons/postituomari.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "postituomari@jaricode.fi",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "PostiTuomari",
    "default_label": "PostiTuomari",
    "default_icon": "icons/postituomari.svg",
    "default_popup": "popup/index.html"
  },
  "permissions": [
    "accountsRead",
    "accountsFolders",
    "messagesRead",
    "messagesMove",
    "storage"
  ],
  "host_permissions": ["https://api.openai.com/*"]
}
